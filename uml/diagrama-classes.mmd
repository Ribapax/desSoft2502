classDiagram
    class Tenant {
        +id: string
        +name: string
        +description?: string
        +status: boolean
        +createdAt: string
        +roles?: Role[]
    }

    class Role {
        +id: string
        +name: string
        +description?: string
    }

    class User {
        +id: string
        +name: string
        +email: string
        +phone?: string
        +createdAt: string
        +roles: Role[]
        +tenantIds?: string[]
    }

    class Space {
        +id: string
        +name: string
        +description: string
        +capacity: number
        +pricePerHour: number
        +coverImageUrl?: string
        +tenantId?: string
        +createdAt: string
    }

    class Reservation {
        +id: string
        +userId: string
        +spaceId: string
        +startDate: string
        +endDate: string
        +totalPrice: number
        +status: ReservationStatus
        +createdAt: string
        +updatedAt: string
    }

    class Payment {
        +id: string
        +reservationId: string
        +amount: number
        +status: PaymentStatus
        +paidAt: string
        +createdAt: string
    }

    class ReservationStatus {
        <<enumeration>>
        PENDING
        CONFIRMED
        CANCELLED
    }

    class PaymentStatus {
        <<enumeration>>
        SIGNAL
        FULL
    }

    Reservation --> User : userId
    Reservation --> Space : spaceId
    Payment --> Reservation : reservationId
    Reservation --> ReservationStatus
    Payment --> PaymentStatus
    User --> Role : roles
    Tenant --> Role : roles

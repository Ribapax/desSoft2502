graph TB
    subgraph "Apresentação (src/app)"
        ROUTES[Express Router / routes]
        CTRL[Controladores REST]
        VALID[Validadores Zod]
        MIDDLE["Middlewares (ex.: error handler)"]
    end

    subgraph "Aplicação (src/application)"
        US[UserService]
        SS[SpaceService]
        RS[ReservationService]
        PS[PaymentService]
    end

    subgraph "Domínio (src/domain)"
        ENT[Entidades (interfaces TS)]
        ENUMS[Enums de status]
        ERR[AppError]
    end

    subgraph "Persistência (src/infra)"
        REPOS[Repositórios SQLite]
        DBCONN[Conexão better-sqlite3]
    end

    DATA[(data/database.sqlite)]

    ROUTES --> CTRL
    CTRL --> VALID
    CTRL --> MIDDLE
    CTRL --> US
    CTRL --> SS
    CTRL --> RS
    CTRL --> PS

    US --> ENT
    SS --> ENT
    RS --> ENT
    PS --> ENT

    ENT --> ENUMS
    ERR --> CTRL
    ERR --> US
    ERR --> SS
    ERR --> RS
    ERR --> PS

    US --> REPOS
    SS --> REPOS
    RS --> REPOS
    PS --> REPOS

    REPOS --> DBCONN
    DBCONN --> DATA

    style ROUTES fill:#E3F2FD
    style CTRL fill:#E3F2FD
    style VALID fill:#E3F2FD
    style MIDDLE fill:#E3F2FD
    style US fill:#E8F5E9
    style SS fill:#E8F5E9
    style RS fill:#E8F5E9
    style PS fill:#E8F5E9
    style ENT fill:#FFF3E0
    style ENUMS fill:#FFF3E0
    style ERR fill:#FFF3E0
    style REPOS fill:#FCE4EC
    style DBCONN fill:#FCE4EC
    style DATA fill:#F3E5F5
